{
  "name": "kostenplan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:editor-mobiel": "node scripts/mobile-ux/editor-mobiel-test.js",
    "test:offerte-e2e": "node scripts/mobile-ux/offerte-e2e.js",
    "test:branding-extract": "tsx scripts/test-branding-extract.ts",
    "audit:onderdelen": "tsx scripts/audit-onderdelen.ts",
    "prijzen:regressie": "tsx --conditions=react-server scripts/prijzen-regressie.ts",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "vercel-build": "prisma migrate deploy && next build",
    "cf:assets": "node cloudflare/reserve/build-assets.mjs",
    "cf:deploy": "node cloudflare/reserve/build-assets.mjs && npx wrangler deploy --config cloudflare/reserve/wrangler.toml",
    "test:env": "bash scripts/test/start-env.sh",
    "test:seed": "bash scripts/test/reset-db.sh",
    "test:e2e": "playwright test",
    "test:visueel": "playwright test --grep \"visuele basislijn\"",
    "test:visueel:bijwerken": "playwright test --grep \"visuele basislijn\" --update-snapshots",
    "test:lighthouse": "node scripts/test/lighthouse.mjs --ci",
    "test:all": "vitest run && npm run test:seed && playwright test && node scripts/test/lighthouse.mjs --ci",
    "test:agents": "bash scripts/test/agents-ronde.sh",
    "pretest:e2e": "bash scripts/test/reset-db.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mollie/api-client": "^4.6.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "@types/leaflet": "^1.9.22",
    "@vercel/blob": "^2.8.1",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "minisearch": "^7.2.0",
    "next": "16.2.10",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "node-vibrant": "^4.0.4",
    "pg": "^8.22.0",
    "playwright-core": "^1.64.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "axe-core": "^4.14.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "fast-check": "^4.10.2",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
