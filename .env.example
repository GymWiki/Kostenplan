# Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# Supabase dashboard -> "Connect" button -> "Transaction pooler" tab (port
# 6543). Used for all runtime queries — transaction-mode pooling multiplexes
# many short-lived serverless invocations over few real Postgres
# connections, which the session pooler (below) can't do at any real scale.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Supabase dashboard -> "Connect" button -> "Session pooler" tab (port 5432).
# Used only by Prisma Migrate for schema changes — transaction-mode pooling
# doesn't support the advisory locks/prepared statements Migrate needs.
# Use the pooler host (contains "pooler.supabase.com"), not the direct
# "db.<project-ref>.supabase.co" host — that one is IPv6-only and will fail
# to connect from IPv4-only networks (most CI/local setups).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mollie (https://my.mollie.com/dashboard/developers/api-keys) — the API key
# itself is set directly in the Vercel dashboard, not committed here.
# MOLLIE_API_KEY="test_..."
#
# Vaste, publieke callback-URL waar Mollie betaal-/abonnementsupdates naartoe
# POST't (zie app/api/mollie/webhook/route.ts). Moet de productie-URL zijn,
# niet een per-deploy preview-URL — anders kan Mollie de webhook niet meer
# bereiken zodra de preview-deployment verdwijnt.
# MOLLIE_WEBHOOK_URL="https://www.kostenplan.nl/api/mollie/webhook"

# IndexNow (zie app/api/indexnow/route.ts): pingt Bing/Yandex/Naver/Seznam/
# Yep met de sitemap-URL's na elke productie-deploy (.github/workflows/
# indexnow.yml). INDEXNOW_KEY is bewust GEEN geheim — moet exact overeenkomen
# met de inhoud én bestandsnaam van public/<key>.txt, dat is hoe IndexNow
# domein-eigenaarschap verifieert. Bij het roteren van de key dus altijd
# beide tegelijk aanpassen.
# INDEXNOW_KEY="<32-karakter-hex-string, zie public/<key>.txt>"
#
# INDEXNOW_TRIGGER_SECRET is wél geheim: beschermt de route tegen misbruik
# door willekeurige aanroepers (die anders IndexNow-quota konden opmaken).
# Zelfde waarde ook als repo-secret in GitHub Actions instellen.
# INDEXNOW_TRIGGER_SECRET="<willekeurige lange random string>"

# --- Embed-weerbaarheid (zie docs/resilience.md) ---------------------------
# Vercel Blob: bewaart de gepubliceerde rekentool-kopieën (snapshots), los van
# de database. Aanmaken: Vercel-dashboard > Storage > Create > Blob (public),
# koppel aan dit project; het token verschijnt dan vanzelf als omgevings-
# variabele. Zonder dit token leest de embed gewoon uit de database.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Optioneel: publieke basis-URL van de store als ze niet uit het token is af te leiden.
# SNAPSHOT_BASE_URL="https://<store-id>.public.blob.vercel-storage.com"
#
# Geheim voor de dagelijkse snapshot-controle (niet voor offertes; Vercel Cron stuurt het zelf mee).
# CRON_SECRET="<willekeurige lange random string>"
#
# Optioneel: webhook (Slack/Discord/Better Stack) voor alarmmeldingen.
# ALERT_WEBHOOK_URL="https://hooks.slack.com/services/..."
#
# E-mail (Brevo) alleen voor leadmeldingen; offertes gebruiken dit niet. Zonder sleutel blijft een lead gewoon in de database staan.
# BREVO_API_KEY="xkeysib-..."
# MAIL_AFZENDER_EMAIL="aanvragen@kostenplan.nl"
# MAIL_AFZENDER_NAAM="Kostenplan"
#
# Niveau 2 (Cloudflare), allemaal optioneel — zie docs/resilience.md:
# SNAPSHOT_MIRROR_URL="https://kostenplan-reserve.<account>.workers.dev"
# CF_MIRROR_WRITE_URL="https://kostenplan-reserve.<account>.workers.dev"
# CF_MIRROR_TOKEN="<zelfde waarde als MIRROR_TOKEN in de Worker>"
# CF_INGEST_TOKEN="<zelfde waarde als INGEST_TOKEN in de Worker>"

# --- Meldingen bij een nieuwe lead (Web Push) ---------------------------------
# Aanmaken: `npx web-push generate-vapid-keys` (geeft een publieke en een private
# sleutel). Zet de publieke in NEXT_PUBLIC_VAPID_PUBLIC_KEY (ook zichtbaar in de
# browser, dat hoort zo), de private in VAPID_PRIVATE_KEY (geheim). Zonder deze
# twee is Profiel > Meldingen verborgen. Opnieuw deployen na het zetten.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="B..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:info@kostenplan.nl"
