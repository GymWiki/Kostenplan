// Prisma schema for Kostenplan
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Geen url/directUrl hier — Prisma 7 verbiedt datasource-URLs in het
  // schema-bestand zelf (P1012: "no longer supported in schema files").
  // Runtime-verbinding loopt via de PrismaPg-adapter in app/lib/prisma.ts;
  // de verbinding die Migrate gebruikt staat in prisma.config.ts.
}

enum ArbeidStapEenheid {
  UUR
  DAGDEEL
  DAG
}

enum ExtraOptionType {
  PER_EENHEID
  PER_STUK
}

// Of een prijs een vast bedrag is, of een bandbreedte (min/max). Gebruikt
// door MaterialOption — zie de min/max-velden op dat model.
enum PrijsType {
  VAST
  BANDBREEDTE
}

// Bepaalt hoe de klant bij een product tot een hoeveelheid komt — zie
// app/lib/sjablonen.ts voor de bijbehorende velden/berekening per sjabloon.
// Alles ná de hoeveelheid (arbeid, materiaalcategorieën, prijsPerEenheid,
// transport) is gedeeld en ongewijzigd, ongeacht het sjabloon.
enum ProductSjabloon {
  // Huidig/enige gedrag vóór sjablonen: klant vult direct de hoeveelheid in
  // de eenheid van het product in. Blijft het default-sjabloon zodat
  // bestaande producten ongewijzigd functioneren.
  ENKELE_HOEVEELHEID
  // Klant vult lengte × breedte (m²) of lengte × breedte × diepte (m³) in.
  AFMETINGEN
  // Klant voegt ruimtes toe (naam + l×b×h); vloer-/plafond-/wandoppervlak
  // worden afgeleid en (voor zover de vakman dat bij het product aanvinkt)
  // samengeteld tot één m²-hoeveelheid.
  RUIMTES
  // Klant stelt een lijst regels samen (artikeltype + afmetingen/aantal).
  // Elk artikeltype heeft een eigen prijs — wijkt daarmee af van het
  // hoeveelheid-×-prijsPerEenheid-patroon, zie app/lib/sjablonen.ts.
  ARTIKELREGELS
}

// Per-berekening instelling (zie CostSettings.bandbreedteModus) die bepaalt
// hoe bandbreedte-prijzen worden doorgerekend. De standen sluiten elkaar uit
// — zie app/lib/calculate.ts calculateBreakdownRange() voor de doorrekening.
enum BandbreedteModus {
  // Huidig gedrag: één vast bedrag. Bandbreedte-prijzen (indien aanwezig)
  // worden herleid tot hun gemiddelde van min/max.
  GEEN
  // Rekent twee keer door: eenmaal met alle minima, eenmaal met alle
  // maxima van bandbreedte-producten. Vaste prijzen tellen in
  // beide scenario's hetzelfde mee.
  PER_PRODUCT
  // Rekent één keer door met vaste bedragen (bandbreedte-prijzen herleid
  // tot hun gemiddelde), en past daarna een marge toe op het eindtotaal.
  TOTAAL
}

// Bepaalt welke features ontgrendeld zijn — zie app/lib/subscription.ts
// effectiveTier() voor hoe dit samen met User.overrideTier wordt bepaald.
enum SubscriptionTier {
  GRATIS
  PLUS
  PRO
}

enum BillingInterval {
  MAANDELIJKS
  JAARLIJKS
}

// Mirrort Mollie's eigen subscription-statussen 1-op-1 (zie
// @mollie/api-client SubscriptionStatus) om vertaalfouten in de
// webhook-verwerking te voorkomen. GEEN = er is nog nooit een Mollie-
// abonnement geweest (bijv. een Gratis-tenant die nooit heeft betaald).
enum MollieSubscriptionStatus {
  GEEN
  PENDING
  ACTIVE
  CANCELED
  SUSPENDED
  COMPLETED
}

enum Lettertype {
  MODERN
  KLASSIEK
  VRIENDELIJK
  STOER
}

enum ContactPositie {
  BOVENAAN
  ONDERAAN
}

// Doorloopt de pipeline van links (NIEUW) naar rechts (GEWONNEN/VERLOREN) op
// het Kanban-board in /dashboard/leads.
enum LeadStatus {
  NIEUW
  IN_BEHANDELING
  OFFERTE_VERSTUURD
  GEWONNEN
  VERLOREN
  // Aanvraag afgehandeld buiten Kostenplan om (zie Deel 1 van de
  // offerte-afhandelingsflow, app/lib/actions/offertes.ts
  // markExternAfgehandeldAction) — de vakman heeft zelf een offerte gestuurd,
  // Kostenplan houdt alleen het moment en een optionele notitie bij.
  EXTERN_AFGEHANDELD
}

// id matches auth.users.id from Supabase Auth — the profile row is created
// right after a successful sign-up (see app/lib/actions/auth.ts). Purely a
// personal identity record: everything business-related (bedrijfsnaam, slug,
// abonnement, catalogus) lives on Company — see that model for why.
model User {
  id    String @id
  email String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyMemberships CompanyMember[]
  // Bedrijven die deze gebruiker heeft aangemaakt — bij een bestaande
  // gebruiker is dit (na de multi-company-migratie) hun oorspronkelijke,
  // automatisch aangemaakte bedrijf; bij een nieuw bedrijf (zie
  // company_members) de daadwerkelijke aanmaker.
  createdCompanies   Company[] @relation("CompanyCreator")

  brandingExtractionAttempts BrandingExtractionAttempt[]
}

// Eén rij per aanroep van /api/branding/extract — puur voor de rate-limit
// (max 10/uur/gebruiker, zie de route) en lichte observability. Bewust geen
// volledig geëxtraheerd resultaat opslaan, alleen wat nodig is om misbruik
// te herkennen en een falende extractie te kunnen nazien.
model BrandingExtractionAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceUrl String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Reden die een gebruiker optioneel opgeeft bij het opzeggen van een
// abonnement (zie de retentie-flow in app/components/dashboard/
// cancel-retention-modal.tsx) — puur voor patroonherkenning, nooit gebruikt
// om opzeggen te blokkeren of te vertragen.
enum OpzegReden {
  TE_DUUR
  GEBRUIK_TE_WEINIG
  MIST_FUNCTIE
  ANDERS
}

// Eén rij per daadwerkelijk uitgevoerde opzegging (niet bij pauzeren of
// downgraden, alleen bij de definitieve keuze voor Gratis). Bewust los van
// Company i.p.v. een veld erop: een bedrijf kan in theorie meerdere keren
// opzeggen (opnieuw abonneren, later weer opzeggen), en elke reden blijft zo
// een eigen tijdgebonden rij.
model CancellationFeedback {
  id         String     @id @default(cuid())
  companyId  String
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reden      OpzegReden
  toelichting String?
  createdAt  DateTime   @default(now())

  @@index([companyId])
}

// Eén bedrijf/tenant. Alles wat vroeger op User stond (bedrijfsnaam, slug,
// abonnement, catalogus) hoort hier nu bij — een gebruiker kan lid zijn van
// meerdere companies (zie CompanyMember), elk met een eigen catalogus,
// huisstijl en abonnement.
model Company {
  id        String  @id @default(cuid())
  naam      String
  // Bepaalt de publieke portaal-URL (/portaal/[slug]) — ongewijzigd van
  // vorm t.o.v. vóór multi-company, alleen nu op Company i.p.v. User.
  slug      String  @unique
  kvkNummer String?
  adres     String?

  // Permanente brug voor bedrijven die zijn ontstaan uit de multi-company-
  // migratie van een bestaande, vóór-migratie User: laat de Mollie-webhook
  // en andere legacy-verwijzingen een company terugvinden aan de hand van
  // het oude userId. Blijft nodig zolang er Mollie-abonnementen bestaan die
  // vóór deze migratie zijn aangemaakt — hun metadata bevat permanent het
  // oude userId, niet het companyId (Mollie-metadata is onveranderlijk na
  // aanmaak). Null voor bedrijven die na de migratie zijn aangemaakt.
  migratedFromUserId String? @unique

  createdBy String
  creator   User   @relation("CompanyCreator", fields: [createdBy], references: [id])

  // Het abonnement zoals Mollie-webhooks het bijhouden — zie effectiveTier().
  subscriptionTier SubscriptionTier  @default(GRATIS)
  // Handmatige override — uitsluitend via Supabase Studio (Table editor of
  // SQL Editor) te zetten, nooit via de app-UI, en nooit door de
  // Mollie-webhook aangepast. Heeft absolute voorrang op subscriptionTier.
  // Zet dit bijv. op PRO om een bedrijf (support, demo, VIP-klant) volledig
  // toegang te geven ongeacht de daadwerkelijke betaalstatus:
  //   update "Company" set "overrideTier" = 'PRO' where slug = '...';
  // Terugzetten naar het echte, betaalde abonnement: zet het veld op NULL.
  overrideTier     SubscriptionTier?

  // Mollie-koppeling. mollieCustomerId wordt aangemaakt bij de eerste
  // checkout-poging; mollieSubscriptionId pas zodra de eerste betaling is
  // geslaagd en er een doorlopend abonnement is aangemaakt.
  mollieCustomerId     String?                  @unique
  mollieSubscriptionId String?                  @unique
  subscriptionStatus   MollieSubscriptionStatus @default(GEEN)
  billingInterval      BillingInterval?
  // Informatief: wanneer Mollie de eerstvolgende/laatst bekende
  // termijnbetaling verwacht (subscription.nextPaymentDate).
  huidigePeriodeEind   DateTime?

  // Retentie-alternatief voor volledig opzeggen (zie pauseSubscriptionAction
  // in app/lib/actions/companies.ts): het Mollie-abonnement wordt meteen
  // beëindigd (geen betalingen meer), maar subscriptionTier blijft ongewijzigd
  // tot deze datum, zodat de klant zijn/haar betaalde functies gewoon kan
  // blijven gebruiken tijdens de pauze. requireActiveCompany() (zie
  // app/lib/dal.ts) zet subscriptionTier lazy terug naar GRATIS zodra dit
  // moment is verstreken — geen aparte cronjob nodig.
  gepauzeerdTot DateTime?

  // Onboarding-checklist op het dashboard (zie app/lib/onboarding.ts). De
  // eerste twee stappen (bedrijfsgegevens, eerste catalogusitem) worden
  // live afgeleid van bestaande data — nooit hier apart opgeslagen, dat zou
  // stale kunnen raken (bijv. als iemand hun enige product weer verwijdert).
  // "Portaal bekeken" heeft geen natuurlijk databaseer-spoor (een publiek,
  // anoniem bezoek), dus die stap wordt hier wél expliciet vastgelegd zodra
  // de link vanuit het dashboard wordt aangeklikt. onboardingVoltooid is de
  // permanente vlag die de widget voorgoed verbergt zodra alle stappen ooit
  // tegelijk voltooid zijn geweest.
  onboardingPortaalBekeken Boolean @default(false)
  onboardingVoltooid       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members              CompanyMember[]
  costSettings         CostSettings?
  branding             Branding?
  products             Product[]
  leads                Lead[]
  cancellationFeedback CancellationFeedback[]
}

// Koppelt een User aan een Company waar die toegang toe heeft. `rol` is
// bewust een vrij tekstveld (geen enum): vandaag is "owner" de enige
// geldige waarde, maar een toekomstige medewerkersrol kan zo worden
// toegevoegd zonder schema-migratie.
model CompanyMember {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rol       String  @default("owner")

  createdAt DateTime @default(now())

  @@unique([companyId, userId])
  @@index([userId])
}

// White-label/personalisatie-instellingen voor het klantenportaal. Los van
// CostSettings (dat gaat over prijslogica, dit over uitstraling en copy).
model Branding {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Publieke URL van een logo in Supabase Storage. Optioneel — zonder logo
  // toont het portaal het standaard Kostenplan-merkteken.
  logoUrl String?

  // Kleuren en lettertype: alleen te wijzigen/tonen op Plus/Pro (zie
  // effectiveTier() in app/lib/subscription.ts en updateBrandingAction voor
  // de server-side afdwinging). Gratis-tenants houden altijd de
  // Kostenplan-standaardkleuren en het standaardlettertype, ongeacht wat
  // hier is opgeslagen (bijv. na een downgrade).
  primaireKleur    String     @default("#15803d")
  achtergrondKleur String     @default("#f7faf8")
  lettertype       Lettertype @default(MODERN)

  // Content & copywriting — beschikbaar op alle tiers. "{bedrijfsnaam}" in
  // customTitel wordt vervangen door Company.naam.
  customTitel   String?
  welkomstTekst String?
  bedankTekst   String  @default("Bedankt voor uw aanvraag! Wij nemen binnen 24 uur contact met u op.")

  // Bedrijfsgegevens tonen — beschikbaar op alle tiers.
  toonTelefoonnummer Boolean        @default(false)
  telefoonnummer     String?
  toonEmail          Boolean        @default(false)
  contactPositie     ContactPositie @default(BOVENAAN)

  // Offerte-standaarden (zie Offerte hieronder) — vullen alleen een nieuw
  // offerteconcept vóór, blijven daarna per offerte los overschrijfbaar.
  offerteIntroTekst       String?
  offerteVoorwaardenTekst String?
  offerteGeldigheidsdagen Int     @default(30)

  updatedAt DateTime @updatedAt
}

model CostSettings {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Arbeidskosten — geldt voor Producten (Product.productiviteit). Drie
  // losse tarieven (i.p.v. één) zodat het wisselen van arbeidStapEenheid
  // nooit een bestaand tarief herinterpreteert als een bedrag voor een
  // andere tijdseenheid.
  arbeidEnabled       Boolean           @default(true)
  arbeidZichtbaar     Boolean           @default(true)
  arbeidStapEenheid   ArbeidStapEenheid @default(UUR)
  arbeidTariefUur     Float             @default(45)
  arbeidTariefDagdeel Float             @default(180)
  arbeidTariefDag     Float             @default(360)
  // Rond de arbeidstijd van een product af op hele arbeidStapEenheid-stappen
  // (bijv. altijd hele dagdelen) i.p.v. 'm continu (lineair) door te rekenen.
  // Uit (continu) is de standaard — zie calculate.ts.
  arbeidAfronden      Boolean           @default(false)

  // Transportkosten — company-brede standaard, per product te overschrijven
  // (Product.transportkostenOverride) en optioneel meeschalend met de
  // hoeveelheid (Product.transportMeeschalend, standaard uit).
  transportEnabled   Boolean @default(true)
  transportZichtbaar Boolean @default(true)
  transportTarief    Float   @default(0)

  // Voorrijkosten — zelfde opzet als transport hierboven.
  voorrijEnabled   Boolean @default(true)
  voorrijZichtbaar Boolean @default(true)
  voorrijTarief    Float   @default(35)

  // Materiaalkosten — geldt voor Producten (materiaalCategorieen).
  // Geen aparte marge-/opslaglaag meer: elke ingevulde materiaalprijs is al
  // een verkoopprijs, inclusief de marge van de vakman.
  materiaalEnabled   Boolean @default(true)
  materiaalZichtbaar Boolean @default(true)

  btwPercentage Float @default(21)

  // Prijsbandbreedte — per berekening, sluit de drie standen wederzijds uit
  // (zie BandbreedteModus). Marges gelden alleen voor modus TOTAAL.
  bandbreedteModus        BandbreedteModus @default(GEEN)
  bandbreedteMargeOmlaag  Float            @default(10)
  bandbreedteMargeOmhoog  Float            @default(10)

  updatedAt DateTime @updatedAt
}

// Een samengesteld product, bijv. "Schutting". De klant kiest een
// hoeveelheid, een materiaal per materiaalcategorie (bijv. "Palen") en
// eventueel extra opties.
model Product {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  naam         String
  omschrijving String?
  eenheid      String  @default("m1")

  // Kostenopbouw, blok 2 (arbeid) — materiaalkosten lopen via
  // materiaalCategorieen hieronder, transport/voorrij hierna. Zie
  // app/lib/calculate.ts voor hoe deze vier blokken samenkomen.
  // Aantal eenheden dat de vakman (of zijn team) haalt per
  // CostSettings.arbeidStapEenheid (bijv. 5 m schutting per dagdeel). Leeg
  // betekent dat dit product geen arbeidstijd kost.
  productiviteit       Float?
  // Vervangt het company-tarief (CostSettings.arbeidTariefUur/Dagdeel/Dag,
  // welke van de drie hangt af van arbeidStapEenheid) voor dit product.
  // Leeg = gebruik het tarief uit Kosteninstellingen.
  arbeidTariefOverride Float?

  // Kostenopbouw, blok 3 (transport). Vervangt CostSettings.transportTarief
  // voor dit product; leeg = gebruik het bedrag uit Kosteninstellingen.
  transportkostenOverride Float?
  // Telt transport één keer mee per project (uit, standaard) in plaats van
  // vermenigvuldigd met de hoeveelheid (aan).
  transportMeeschalend    Boolean @default(false)

  // Kostenopbouw, blok 4 (voorrijkosten) — zelfde opzet als transport
  // hierboven.
  voorrijkostenOverride Float?
  voorrijMeeschalend    Boolean @default(false)

  // Naam van een lucide-react icoon uit app/lib/icons.ts, bijv. "Fence".
  // Optioneel, puur decoratief.
  icoon  String?
  actief Boolean @default(true)
  order  Int     @default(0)

  // Bepaalt hoe de klant tot een hoeveelheid komt — zie ProductSjabloon.
  // Default ENKELE_HOEVEELHEID zodat bestaande producten (en de migratie
  // die deze kolom toevoegt) ongewijzigd blijven werken.
  sjabloon       ProductSjabloon @default(ENKELE_HOEVEELHEID)
  // Sjabloon-specifieke instellingen van de vakman (bijv. AFMETINGEN:
  // { metDiepte }, RUIMTES: { telVloerMee, telPlafondMee, telWandMee,
  // standaardAftrek }, ARTIKELREGELS: { artikelTypes: [...] }). Leeg voor
  // ENKELE_HOEVEELHEID. Vorm gedefinieerd in app/lib/sjablonen.ts, niet
  // hier — hier alleen opslag.
  sjabloonConfig Json?

  // Kostenopbouw, blok 1 (materiaal) — altijd via materiaalCategorieen: elk
  // product heeft er na aanmaken minstens één met minstens één optie in.
  // Heeft die ene categorie precies één optie, dan kiest de klant niets en
  // telt die optie automatisch mee (zie calculator.tsx).
  materiaalCategorieen MaterialCategory[]
  extraOpties          ExtraOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// Onderdeel van een product waarvoor de klant één materiaal kiest,
// bijv. "Palen" of "Tussenbekleding" binnen het product "Schutting".
model MaterialCategory {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  naam  String
  order Int    @default(0)
  // Verplicht een keuze uit deze categorie voordat de klant een offerte kan
  // aanvragen. Zonder dit blijft een prijsindicatie mogelijk terwijl
  // materiaalkosten stil op €0 blijven staan omdat er niets is gekozen.
  verplicht Boolean @default(false)

  materialen MaterialOption[]

  createdAt DateTime @default(now())

  @@index([productId])
}

// Een keuzeoptie binnen een materiaalcategorie, bijv. "Betonnen palen".
// `prijs` is de volledige verkoopprijs per eenheid van het bijbehorende
// product — wat de vakman de klant hiervoor rekent, inclusief zijn eigen
// marge. Geen meerprijs bovenop een aparte basisprijs (dat model is
// vervallen) en geen aparte opslaglaag: dit ís het verkooptarief.
model MaterialOption {
  id                 String           @id @default(cuid())
  materialCategoryId String
  materialCategory   MaterialCategory @relation(fields: [materialCategoryId], references: [id], onDelete: Cascade)

  naam        String
  prijs       Float   @default(0)
  // Vast (default) of bandbreedte — zie PrijsType. Bij BANDBREEDTE wordt
  // prijsMin/prijsMax gebruikt in plaats van het vaste `prijs`-veld.
  prijsType   PrijsType @default(VAST)
  prijsMin    Float?
  prijsMax    Float?
  // Wordt verkocht per veelvoud van deze hoeveelheid (in de eenheid van het
  // product), bijv. 1.8 voor een paal die per 1,8 m wordt ingekocht. Leeg
  // betekent doorlopend geprijsd, zonder afronding.
  stapgrootte Float?
  // Vervangt Product.productiviteit voor dit ene materiaal — sommige
  // materialen (bijv. natuursteen t.o.v. betontegel) leggen trager. Leeg =
  // gebruik de productiviteit van het product.
  productiviteitOverride Float?
  // Publieke URL van een foto in Supabase Storage. Optioneel.
  foto        String?
  actief      Boolean @default(true)
  order       Int     @default(0)

  createdAt DateTime @default(now())

  @@index([materialCategoryId])
}

// Optionele toevoeging op een product, bijv. "Metalen tussenbekleding
// voor planten". Bij PER_EENHEID vinkt de klant de optie aan en telt hij
// mee met de hoeveelheid van het product (prijs per eenheid). Bij
// PER_STUK geeft de klant een eigen aantal op, los van de hoeveelheid
// van het product (prijs per stuk).
model ExtraOption {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  naam         String
  omschrijving String?
  prijs        Float           @default(0)
  type         ExtraOptionType @default(PER_EENHEID)
  // Publieke URL van een foto in Supabase Storage. Optioneel.
  foto         String?
  actief       Boolean         @default(true)
  order        Int             @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
}

// Een offerte-aanvraag vanuit het publieke klantenportaal — de mini-CRM voor
// de vakman op /dashboard/leads. Alleen aangemaakt door createLeadAction
// (zie app/lib/actions/leads.ts), en alleen als de tenant Plus/Pro is (zie
// effectiveTier() in app/lib/subscription.ts) — dit is dezelfde gate als de
// "Offerte aanvragen"-knop zelf op het portaal.
model Lead {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  naam           String
  email          String
  telefoonnummer String?

  status LeadStatus @default(NIEUW)

  // Bevroren op het moment van aanvragen — wat de consument had aangevinkt
  // en welke prijsindicatie daarbij hoorde. Los van de huidige Diensten/
  // Producten van de tenant, die intussen gewijzigd of verwijderd kunnen
  // zijn. Vorm: zie LeadSnapshot in app/lib/leads.ts.
  snapshot        Json
  // Los uit snapshot.totaal getrokken zodat de Pipeline Waarde-KPI zonder
  // JSON-parsing op de database kan optellen/filteren.
  totaalIndicatie Float

  notities LeadNote[]
  offerte  Offerte?

  // Gezet door markExternAfgehandeldAction wanneer status EXTERN_AFGEHANDELD
  // wordt. Notitie is bewust optioneel — geen verplichte stap.
  externAfgehandeldOp       DateTime?
  externAfgehandeldNotitie  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
}

// Individuele, los bewerkbare/verwijderbare aantekening bij een Lead (zie
// LeadDetailDrawer).
model LeadNote {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  tekst String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
}

// Levenscyclus van een Offerte (zie hieronder). Nooit automatisch van
// CONCEPT naar VERSTUURD — dat gebeurt uitsluitend via de expliciete
// "genereer offerte om te delen"-actie van de vakman zelf.
enum OfferteStatus {
  CONCEPT
  VERSTUURD
  GEACCEPTEERD
  AFGEWEZEN
  VERLOPEN
  // Zachte statuswijziging (geen verwijdering) voor een VERSTUURD-offerte die
  // de vakman terugtrekt — de rij en de historie blijven bestaan, alleen de
  // publieke link toont voortaan een "niet meer beschikbaar"-melding. Alleen
  // bereikbaar vanuit VERSTUURD, zie intrekOfferteAction in
  // app/lib/actions/offertes.ts.
  INGETROKKEN
}

// Eén (bewerkbaar) offerte-object per Lead — losstaand van eventuele latere
// klant-communicatie (bewust geen ingebouwd chatkanaal in deze fase, zie
// app/lib/actions/offertes.ts): delen gebeurt via een link/PDF die de
// vakman zelf verspreidt. 1-op-1 met Lead (leadId @unique) i.p.v. een
// geschiedenis van meerdere offertes — een vakman past een bestaand concept
// aan en genereert desnoods een nieuwe link, in plaats van een nieuwe rij
// aan te maken.
model Offerte {
  id     String @id @default(cuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  status OfferteStatus @default(CONCEPT)

  // Vrij bewerkbare regels — vooraf gevuld vanuit Lead.snapshot (zie
  // prefillOfferteRegels in app/lib/offertes.ts), daarna volledig los van de
  // oorspronkelijke berekening. Vorm: OfferteRegel[] in app/lib/offertes.ts.
  regels Json

  // Beide vooraf gevuld vanuit Branding.offerteIntroTekst/
  // offerteVoorwaardenTekst op het moment van aanmaken, maar per offerte
  // altijd los aanpasbaar — een latere wijziging van de standaardtekst raakt
  // bestaande offertes dus nooit met terugwerkende kracht.
  introTekst       String?
  voorwaardenTekst String?

  geldigTot DateTime

  // Pas gezet zodra de vakman daadwerkelijk op "genereer offerte om te
  // delen" klikt (zie genereerDeelLinkAction, die zelf crypto.randomUUID()
  // aanroept) — vóór dat moment bestaat er geen publieke URL, ongeacht de
  // status. Nooit een oplopend/voorspelbaar ID, altijd 122 bits echte
  // willekeur, dus onraadbaar.
  deelToken String? @unique
  pdfUrl    String?

  verstuurdOp   DateTime?
  ingetrokkenOp DateTime?
  gereageerdOp  DateTime?
  klantReactie  String?
  // Voor de in-app "klant heeft gereageerd"-melding op de aanvragenpagina —
  // false zodra de klant akkoord/niet akkoord geeft, weer true zodra de
  // vakman de offerte (opnieuw) opent.
  reactieGezien Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
